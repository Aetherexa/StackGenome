{
  "name": "stackgenome-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Project ecosystem intelligence for developers.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter stackgenome build",
    "build:packages": "tsc -b packages/contracts packages/knowledge packages/core packages/analyzer-node packages/analyzer-python packages/advisor packages/context packages/service",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "package:vsix": "pnpm --filter stackgenome package:vsix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
